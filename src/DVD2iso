# =============================================================
# Backend
# =============================================================

class DvdBackend:
    """
    Obsługa narzędzi systemowych niezależna od GUI.

    Założenia:
    - nie parsujemy wyjścia dvdbackup do sterowania aplikacją,
    - blockdev służy do rozmiaru medium i kontroli miejsca,
    - parser postępu genisoimage jest opcjonalny.
    """

    REQUIRED_COMMANDS = {
        "lsdvd": "lsdvd",
        "dvdbackup": "dvdbackup",
        "genisoimage": "genisoimage",
        "eject": "eject",
        "blockdev": "util-linux",
    }

    @classmethod
    def missing_commands(cls):
        return [
            command
            for command in cls.REQUIRED_COMMANDS
            if shutil.which(command) is None
        ]

    @staticmethod
    def command_version(command):
        attempts = (
            [command, "--version"],
            [command, "-V"],
            [command, "-v"],
        )

        for args in attempts:
            try:
                result = subprocess.run(
                    args,
                    capture_output=True,
                    text=True,
                    timeout=5,
                )

                text = (
                    result.stdout
                    or result.stderr
                    or ""
                ).strip()

                if text:
                    return text.splitlines()[0][:300]

            except (OSError, subprocess.SubprocessError):
                pass

        return "wersja nierozpoznana"

    @classmethod
    def diagnostic_info(cls):
        lines = [
            f"DVD2iso {APP_VERSION}",
            f"Device: {DEVICE}",
            "",
            "Narzędzia:",
        ]

        for command in cls.REQUIRED_COMMANDS:
            path = shutil.which(command)

            if path:
                version = cls.command_version(command)
                lines.append(
                    f"- {command}: {path} — {version}"
                )
            else:
                lines.append(
                    f"- {command}: BRAK"
                )

        return "\n".join(lines) + "\n"

    @staticmethod
    def detect_dvd():
        result = subprocess.run(
            ["lsdvd", DEVICE],
            capture_output=True,
            text=True,
            timeout=20,
        )

        if result.returncode != 0:
            return None

        match = re.search(
            r"^Disc Title:\s*(.+)$",
            result.stdout,
            re.MULTILINE,
        )

        if not match:
            return None

        return match.group(1).strip()

    @staticmethod
    def medium_size():
        """
        Fizyczny rozmiar medium.

        Używany wyłącznie do:
        - informacji o płycie,
        - konserwatywnego sprawdzania wolnego miejsca.

        Nie używamy go jako mianownika postępu dvdbackup.
        """
        try:
            result = subprocess.run(
                [
                    "blockdev",
                    "--getsize64",
                    DEVICE,
                ],
                capture_output=True,
                text=True,
                timeout=10,
            )

            if result.returncode == 0:
                size = int(
                    result.stdout.strip()
                )

                if size > 0:
                    return size

        except (
            ValueError,
            OSError,
            subprocess.SubprocessError,
        ):
            pass

        return None

    @staticmethod
    def safe_volume_id(name):
        name = name.upper()

        name = re.sub(
            r"[^A-Z0-9_]",
            "_",
            name,
        )

        name = re.sub(
            r"_+",
            "_",
            name,
        ).strip("_")

        return (name or "DVD")[:32]


