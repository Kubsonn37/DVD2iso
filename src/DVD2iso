        self.eject_button.set_sensitive(
            False
        )

        return False

    # =========================================================
    # Nazwa pliku
    # =========================================================

    @staticmethod
    def safe_filename(name):
        name = re.sub(
            r'[\\/:*?"<>|]',
            "_",
            name,
        ).strip()

        return name or "DVD"

    # =========================================================
    # Wybór pliku
    # =========================================================

    def choose_output(
        self,
        _button,
    ):
        if not self.disc_title:
            return

        dialog = Gtk.FileChooserNative(
            title="Zapisz obraz DVD",
            transient_for=self,
            action=Gtk.FileChooserAction.SAVE,
            accept_label="Zapisz",
            cancel_label="Anuluj",
        )

        dialog.set_current_name(
            self.safe_filename(
                self.disc_title
            )
            + ".iso"
        )

        dialog.connect(
            "response",
            self.output_chosen,
        )

        dialog.show()

    def output_chosen(
        self,
        dialog,
        response,
    ):
        if (
            response
            == Gtk.ResponseType.ACCEPT
        ):
            file = dialog.get_file()
            path_string = file.get_path()

            if path_string:
                path = Path(
                    path_string
                )

                if (
                    path.suffix.lower()
                    != ".iso"
                ):
                    path = Path(
                        str(path)
                        + ".iso"
                    )

                self.output_path = path

                self.output_entry.set_text(
                    str(path)
                )

        dialog.destroy()

    # =========================================================
    # Start
    # =========================================================

    def start_rip(
        self,
        _button,
    ):
        if self.running:
            return

        if not self.disc_present:
            self.show_error(
                "Nie wykryto płyty DVD."
            )

            return

        if not self.output_path:
            self.show_error(
                "Nie wybrano pliku docelowego."
            )

            return

        if self.output_path.exists():
            self.confirm_overwrite()

            return

        self.prepare_operation()

    def confirm_overwrite(self):
        dialog = Gtk.AlertDialog()

        dialog.set_message(
            "Plik już istnieje"
        )

        dialog.set_detail(
            f"{self.output_path}\n\n"
            "Czy chcesz go zastąpić?"
        )

        dialog.set_buttons(
            [
                "Anuluj",
                "Zastąp",
            ]
        )

        dialog.set_cancel_button(0)
        dialog.set_default_button(1)

        dialog.choose(
            self,
            None,
            self.overwrite_response,
        )

    def overwrite_response(
        self,
        dialog,
        result,
    ):
        try:
            response = (
                dialog.choose_finish(
                    result
                )
            )

            if response == 1:
                self.prepare_operation()

        except Exception:
            pass

    # =========================================================
    # Kontrola wolnego miejsca
    # =========================================================

    def prepare_operation(self):
        if not self.disc_size:
            self.show_error(
                "Nie udało się odczytać "
                "rozmiaru medium.\n\n"
                "Nie można bezpiecznie oszacować "
                "wymaganego miejsca na operację."
            )

            return

        try:
            CACHE_ROOT.mkdir(
                parents=True,
                exist_ok=True,
            )

            output_parent = (
                self.output_path.parent
            )

            cache_free = (
                shutil.disk_usage(
                    CACHE_ROOT
                ).free
            )

            output_free = (
                shutil.disk_usage(
                    output_parent
                ).free
            )

            same_filesystem = (
                os.stat(CACHE_ROOT).st_dev
                ==
                os.stat(output_parent).st_dev
            )

        except OSError as exc:
            self.show_error(
                "Nie udało się sprawdzić "
                f"wolnego miejsca:\n{exc}"
            )

            return

        # Konserwatywne oszacowanie:
        # skopiowana struktura DVD + ISO + 1 GiB zapasu.

        if same_filesystem:
            required = (
                self.disc_size * 2
                + SPACE_RESERVE
            )

            if cache_free < required:
                self.show_space_error(
                    required,
                    cache_free,
                )

                return

        else:
            cache_required = (
                self.disc_size
                + SPACE_RESERVE
            )

            output_required = (
                self.disc_size
                + SPACE_RESERVE
            )

            if cache_free < cache_required:
                self.show_space_error(
                    cache_required,
                    cache_free,
                )

                return

            if output_free < output_required:
                self.show_space_error(
                    output_required,
                    output_free,
                )

                return

        self.begin_operation()

    def show_space_error(
        self,
        required,
        available,
    ):
        self.show_error(
            "Za mało wolnego miejsca.\n\n"
            f"Potrzeba około: "
            f"{self.format_size(required)}\n"
            f"Dostępne: "
            f"{self.format_size(available)}"
        )

    # =========================================================
    # Rozpoczęcie operacji
    # =========================================================

    def begin_operation(self):
        timestamp = time.strftime(
            "%Y%m%d-%H%M%S"
        )

        self.work_dir = (
            CACHE_ROOT
            / f"job-{timestamp}-{os.getpid()}"
        )

        try:
            self.work_dir.mkdir(
                parents=True,
                exist_ok=False,
            )

            diagnostic_path = (
                self.work_dir
                / "diagnostic.txt"
            )

            diagnostic_path.write_text(
                self.backend.diagnostic_info(),
                encoding="utf-8",
            )

        except OSError as exc:
            self.show_error(
                "Nie udało się przygotować "
                f"katalogu roboczego:\n{exc}"
            )

            return

        self.partial_output_path = Path(
            str(self.output_path)
            + ".part"
        )

        try:
            if (
                self.partial_output_path.exists()
            ):
                self.partial_output_path.unlink()

        except OSError as exc:
            self.show_error(
                "Nie udało się przygotować "
                f"pliku docelowego:\n{exc}"
            )

            return

        self.running = True
        self.cancel_requested = False
        self.close_after_cancel = False

        self.start_time = (
            time.monotonic()
        )

        self.current_stage = "rip"

        self.ripped_size = 0
        self.iso_percent = None
        self.iso_progress_seen = False
        self.last_log = None

        self.start_button.set_sensitive(
            False
        )

        self.choose_button.set_sensitive(
            False
        )

        self.eject_button.set_sensitive(
            False
        )

        self.refresh_button.set_sensitive(
            False
        )

        self.cancel_button.set_sensitive(
            True
        )

        # Dla dvdbackup nie udajemy dokładnego procentu.
        self.progress.set_fraction(0)
        self.progress.set_text(
            "Kopiowanie…"
        )

        self.stage_label.set_text(
            "Etap 1 z 2 — Kopiowanie DVD…"
        )

        self.data_label.set_text(
            "Skopiowano: 0 B"
        )

        self.time_label.set_text(
            "Czas: 00:00"
        )

        threading.Thread(
            target=self.rip_worker,
            daemon=True,
        ).start()

    # =========================================================
    # Główny worker
    # =========================================================

    def rip_worker(self):
        try:
            self.run_dvdbackup()

            if self.cancel_requested:
                return

            dvd_dirs = [
                path
                for path
                in self.work_dir.iterdir()
                if (
                    path.is_dir()
                    and
                    (path / "VIDEO_TS").is_dir()
                )
            ]

            if len(dvd_dirs) != 1:
                raise RuntimeError(
                    "Nie znaleziono prawidłowej "
                    "struktury VIDEO_TS."
                )

            self.dvd_dir = (
                dvd_dirs[0]
            )

            # Tu znamy już faktyczny rozmiar danych
            # utworzonych przez dvdbackup.
            self.ripped_size = (
                self.directory_size(
                    self.dvd_dir
                )
            )

            self.current_stage = "iso"

            GLib.idle_add(
                self.iso_stage_started
            )

            self.run_genisoimage()

            if self.cancel_requested:
                return

            if (
                not self.partial_output_path.exists()
            ):
                raise RuntimeError(
                    "Tymczasowy obraz ISO "
                    "nie został utworzony."
                )

            if (
                self.partial_output_path
                .stat()
                .st_size
                == 0
            ):
                raise RuntimeError(
                    "Utworzony obraz ISO "
                    "jest pusty."
                )

            # Właściwy plik .iso pojawia się
            # dopiero po pełnym sukcesie.
            os.replace(
                self.partial_output_path,
                self.output_path,
            )

            GLib.idle_add(
                self.operation_finished
            )

        except Exception as exc:
            if not self.cancel_requested:
                GLib.idle_add(
                    self.operation_failed,
                    str(exc),
                )

    # =========================================================
    # dvdbackup
    # =========================================================

    def run_dvdbackup(self):
        log_path = (
            self.work_dir
            / "dvdbackup.log"
        )

        self.last_log = log_path

        with log_path.open(
            "w",
            encoding="utf-8",
            errors="replace",
        ) as log:
            process = subprocess.Popen(
                [
                    "dvdbackup",
                    "-i",
                    DEVICE,
                    "-M",
                    "-o",
                    str(self.work_dir),
                ],
                stdout=log,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )

            self.set_process(
                process
            )

            return_code = (
                process.wait()
            )

            self.clear_process(
                process
            )

        if self.cancel_requested:
            return

        if return_code != 0:
            raise RuntimeError(
                "dvdbackup zakończył się "
                "błędem."
            )

    # =========================================================
    # genisoimage
    # =========================================================

    def run_genisoimage(self):
        log_path = (
            self.work_dir
            / "genisoimage.log"
        )

        self.last_log = log_path

        volume_id = (
            self.backend.safe_volume_id(
                self.disc_title
            )
        )

        with log_path.open(
            "w",
            encoding="utf-8",
            errors="replace",
        ) as log:
            process = subprocess.Popen(
                [
                    "genisoimage",
                    "-dvd-video",
                    "-udf",
                    "-V",
                    volume_id,
                    "-o",
                    str(
                        self.partial_output_path
                    ),
                    str(self.dvd_dir),
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
                text=True,
                bufsize=1,
                start_new_session=True,
            )

            self.set_process(
                process
            )

            assert (
                process.stderr
                is not None
            )

            buffer = ""

            # genisoimage może używać zarówno
            # nowych linii, jak i \r.
            while True:
                char = (
                    process.stderr.read(1)
                )

                if not char:
                    break

                log.write(char)

                if char in (
                    "\r",
                    "\n",
                ):
                    self.parse_iso_progress(
                        buffer
                    )

                    buffer = ""

                else:
                    buffer += char

            if buffer:
                self.parse_iso_progress(
                    buffer
                )

            log.flush()

            return_code = (
                process.wait()
            )

            self.clear_process(
                process
            )

        if self.cancel_requested:
            return

        if return_code != 0:
            raise RuntimeError(
                "genisoimage zakończył się "
                "błędem."
            )

    def parse_iso_progress(
        self,
        text,
    ):
        """
        Parser postępu jest tylko dodatkiem do GUI.

        Jeśli przyszła wersja genisoimage zmieni format
        komunikatów, aplikacja nadal tworzy ISO. Pasek
        pozostanie wtedy w trybie nieokreślonym.
        """

        match = re.search(
            r"(\d+(?:\.\d+)?)%\s+done",
            text,
            re.IGNORECASE,
        )

        if not match:
            return

        try:
            percent = float(
                match.group(1)
            )

        except ValueError:
            return

        if not (
            0.0
            <= percent
            <= 100.0
        ):
            return

        self.iso_percent = percent
        self.iso_progress_seen = True

    # =========================================================
    # Proces potomny
    # =========================================================

    def set_process(
        self,
        process,
    ):
        with self.process_lock:
            self.process = process

    def clear_process(
        self,
        process,
    ):
        with self.process_lock:
            if self.process is process:
                self.process = None

    # =========================================================
    # Aktualizacja GUI
    # =========================================================

    def update_progress_display(self):
        if not self.running:
            return True

        self.update_elapsed_time()

        if self.current_stage == "rip":
            self.update_rip_progress()

        elif self.current_stage == "iso":
            self.update_iso_progress()

        return True

    def update_elapsed_time(self):
        if self.start_time is None:
            return

        elapsed = int(
            time.monotonic()
            - self.start_time
        )

        hours, remainder = divmod(
            elapsed,
            3600,
        )

        minutes, seconds = divmod(
            remainder,
            60,
        )

        if hours:
            text = (
                f"{hours:02d}:"
                f"{minutes:02d}:"
                f"{seconds:02d}"
            )

        else:
            text = (
                f"{minutes:02d}:"
                f"{seconds:02d}"
            )

        self.time_label.set_text(
            f"Czas: {text}"
        )

    def update_rip_progress(self):
        if not self.work_dir:
            return

        copied = (
            self.directory_size(
                self.work_dir
            )
        )

        self.ripped_size = copied

        # Nie liczymy copied / disc_size.
        # Są to różne wielkości.
        self.progress.pulse()

        self.progress.set_text(
            "Kopiowanie…"
        )

        self.data_label.set_text(
            "Skopiowano: "
            + self.format_size(
                copied
            )
        )

    def update_iso_progress(self):
        current_size = 0

        if (
            self.partial_output_path
            and
            self.partial_output_path.exists()
        ):
            try:
                current_size = (
                    self.partial_output_path
                    .stat()
                    .st_size
                )

            except OSError:
                pass

        if (
            self.iso_progress_seen
            and self.iso_percent is not None
        ):
            fraction = min(
                max(
                    self.iso_percent
                    / 100.0,
                    0.0,
                ),
                1.0,
            )

            self.progress.set_fraction(
                fraction
            )

            self.progress.set_text(
                f"{self.iso_percent:.0f}%"
            )

        else:
            # Brak rozpoznanego formatu postępu
            # nie jest błędem.
            self.progress.pulse()

            self.progress.set_text(
                "Tworzenie ISO…"
            )

        if self.ripped_size:
            self.data_label.set_text(
                "ISO: "
                f"{self.format_size(current_size)}"
                " / ok. "
                f"{self.format_size(self.ripped_size)}"
            )

        else:
            self.data_label.set_text(
                "ISO: "
                + self.format_size(
                    current_size
                )
            )

    def iso_stage_started(self):
        self.iso_percent = None
        self.iso_progress_seen = False

        self.progress.set_fraction(0)

        self.progress.set_text(
            "Tworzenie ISO…"
        )

        self.stage_label.set_text(
            "Etap 2 z 2 — "
            "Tworzenie obrazu ISO…"
        )

        self.data_label.set_text(
            "ISO: 0 B"
        )

        return False

    # =========================================================
    # Rozmiar katalogu
    # =========================================================

    @staticmethod
    def directory_size(path):
        total = 0

        try:
            for (
                root,
                _dirs,
                files,
            ) in os.walk(path):
                for filename in files:
                    file_path = (
                        Path(root)
                        / filename
                    )

                    try:
                        total += (
                            file_path
                            .stat()
                            .st_size
                        )

                    except OSError:
                        pass

        except OSError:
            pass

        return total

    # =========================================================
    # Format rozmiaru
    # =========================================================

    @staticmethod
    def format_size(size):
        units = (
            "B",
            "KiB",
            "MiB",
            "GiB",
            "TiB",
        )

        value = float(size)

        for unit in units:
            if (
                value < 1024
                or unit == units[-1]
            ):
                if unit == "B":
                    return (
                        f"{int(value)} {unit}"
                    )

                return (
                    f"{value:.2f} {unit}"
                )

            value /= 1024

        return f"{size} B"

    # =========================================================
    # Anulowanie
    # =========================================================

    def cancel_operation(
        self,
        _button=None,
    ):
        if (
            not self.running
            or self.cancel_requested
        ):
            return

        self.cancel_requested = True

        self.stage_label.set_text(
            "Anulowanie operacji…"
        )

        self.cancel_button.set_sensitive(
            False
        )

        with self.process_lock:
            process = self.process

        if process is not None:
            try:
                os.killpg(
                    os.getpgid(
                        process.pid
                    ),
                    signal.SIGTERM,
                )

            except (
                ProcessLookupError,
                PermissionError,
            ):
                pass

        threading.Thread(
            target=self._wait_after_cancel,
            args=(process,),
            daemon=True,
        ).start()

    def _wait_after_cancel(
        self,
        process,
    ):
        if process is not None:
            try:
                process.wait(
                    timeout=10
                )

            except subprocess.TimeoutExpired:
                try:
                    os.killpg(
                        os.getpgid(
                            process.pid
                        ),
                        signal.SIGKILL,
                    )

                except (
                    ProcessLookupError,
                    PermissionError,
                ):
                    pass

        GLib.idle_add(
            self.cancel_finished
        )

    def cancel_finished(self):
        self.running = False
        self.current_stage = None

        self.remove_partial_iso()

        self.progress.set_fraction(0)
        self.progress.set_text("")

        self.stage_label.set_text(
            "Operacja została anulowana."
        )

        self.restore_controls()

        if self.close_after_cancel:
            self.destroy()

        return False

    def remove_partial_iso(self):
        if (
            self.partial_output_path
            and
            self.partial_output_path.exists()
        ):
            try:
                self.partial_output_path.unlink()

            except OSError:
                pass

    # =========================================================
    # Bezpieczne zamykanie
    # =========================================================

    def on_close_request(
        self,
        _window,
    ):
        if not self.running:
            return False

        dialog = Gtk.AlertDialog()

        dialog.set_message(
            "Operacja jest w toku"
        )

        dialog.set_detail(
            "Zamknięcie programu przerwie "
            "kopiowanie DVD.\n\n"
            "Czy chcesz przerwać operację "
            "i zamknąć program?"
        )

        dialog.set_buttons(
            [
                "Kontynuuj kopiowanie",
                "Przerwij i zamknij",
            ]
        )

        dialog.set_cancel_button(0)
        dialog.set_default_button(0)

        dialog.choose(
            self,
            None,
            self.close_response,
        )

        # Nie zamykamy okna, dopóki użytkownik
        # nie potwierdzi i proces potomny nie zakończy się.
        return True

    def close_response(
        self,
        dialog,
        result,
    ):
        try:
            response = (
                dialog.choose_finish(
                    result
                )
            )

            if response == 1:
                self.close_after_cancel = True

                self.cancel_operation()

        except Exception:
            pass

    # =========================================================
    # Sukces
    # =========================================================

    def operation_finished(self):
        self.running = False
        self.current_stage = None

        self.progress.set_fraction(
            1.0
        )

        self.progress.set_text(
            "100%"
        )

        size = (
            self.output_path
            .stat()
            .st_size
        )

        self.data_label.set_text(
            "Gotowy obraz: "
            + self.format_size(size)
        )

        self.stage_label.set_text(
            "Obraz ISO utworzony pomyślnie."
        )

        self.restore_controls()

        dialog = Gtk.AlertDialog()

        dialog.set_message(
            "Obraz ISO został utworzony"
        )

        dialog.set_detail(
            f"{self.output_path}\n\n"
            f"Rozmiar: "
            f"{self.format_size(size)}\n\n"
            "Usunąć pliki robocze?"
        )

        dialog.set_buttons(
            [
                "Zachowaj",
                "Usuń",
            ]
        )

        dialog.set_cancel_button(0)
        dialog.set_default_button(1)

        dialog.choose(
            self,
            None,
            self.cleanup_response,
        )

        return False

    def cleanup_response(
        self,
        dialog,
        result,
    ):
        try:
            response = (
                dialog.choose_finish(
                    result
                )
            )

            if response == 1:
                self.cleanup_work_directory()

        except Exception as exc:
            self.show_error(
                "Nie udało się usunąć "
                f"plików roboczych:\n{exc}"
            )

    # =========================================================
    # Błąd
    # =========================================================

    def operation_failed(
        self,
        message,
    ):
        self.running = False
        self.current_stage = None

        self.remove_partial_iso()

        self.progress.set_fraction(0)
        self.progress.set_text("")

        self.stage_label.set_text(
            "Wystąpił błąd."
        )

        self.restore_controls()

        if self.last_log:
            message += (
                "\n\nLog:\n"
                f"{self.last_log}"
            )

        if self.work_dir:
            diagnostic = (
                self.work_dir
                / "diagnostic.txt"
            )

            if diagnostic.exists():
                message += (
                    "\nDiagnostyka:\n"
                    f"{diagnostic}"
                )

        self.show_error(
            message
        )

        return False

    # =========================================================
    # Kontrolki / czyszczenie
    # =========================================================

    def restore_controls(self):
        self.cancel_button.set_sensitive(
            False
        )

        self.refresh_button.set_sensitive(
            True
        )

        self.start_button.set_sensitive(
            self.disc_present
        )

        self.choose_button.set_sensitive(
            self.disc_present
        )

        self.eject_button.set_sensitive(
            self.disc_present
        )

    def cleanup_work_directory(self):
        if (
            self.work_dir
            and self.work_dir.exists()
        ):
            shutil.rmtree(
                self.work_dir
            )

        self.work_dir = None

    # =========================================================
    # Wysuwanie
    # =========================================================

    def eject_disc(
        self,
        _button,
    ):
        if self.running:
            return

        self.eject_button.set_sensitive(
            False
        )

        self.stage_label.set_text(
            "Wysuwanie płyty…"
        )

        threading.Thread(
            target=self._eject_worker,
            daemon=True,
        ).start()

    def _eject_worker(self):
        try:
            result = subprocess.run(
                [
                    "eject",
                    DEVICE,
                ],
                capture_output=True,
                text=True,
                timeout=15,
            )

            if result.returncode != 0:
                message = (
                    result.stderr.strip()
                    or
                    "Nie udało się wysunąć płyty."
                )

                GLib.idle_add(
                    self.eject_failed,
                    message,
                )

                return

            GLib.idle_add(
                self.eject_started
            )

        except Exception as exc:
            GLib.idle_add(
                self.eject_failed,
                str(exc),
            )

    def eject_started(self):
        self.stage_label.set_text(
            "Płyta została wysunięta."
        )

        return False

    def eject_failed(
        self,
        message,
    ):
        if self.disc_present:
            self.eject_button.set_sensitive(
                True
            )

        self.show_error(
            message
        )

        return False

    # =========================================================
    # Dialog błędu
    # =========================================================

    def show_error(
        self,
        message,
    ):
        dialog = Gtk.AlertDialog()

        dialog.set_message(
            "Wystąpił błąd"
        )

        dialog.set_detail(
            message
        )

        dialog.set_buttons(
            ["OK"]
        )

        dialog.show(self)


# =============================================================
# Aplikacja
# =============================================================

class DvdToIsoApplication(
    Gtk.Application
):
    def __init__(self):
        super().__init__(
            application_id=APP_ID
        )

    def do_activate(self):
        window = DvdToIsoWindow(
            self
        )

        window.present()


# =============================================================
# Start
# =============================================================

def main():
    missing = (
        DvdBackend.missing_commands()
    )

    if missing:
        packages = sorted(
            {
                DvdBackend.REQUIRED_COMMANDS[
                    command
                ]
                for command in missing
            }
        )

        print(
            "Brakuje wymaganych programów: "
            + ", ".join(missing)
        )

        print()
        print(
            "Na Ubuntu zainstaluj:"
        )

        print(
            "sudo apt install "
            + " ".join(packages)
        )

        return 1

    app = DvdToIsoApplication()

    return app.run()


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
