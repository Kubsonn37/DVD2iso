    def setup_volume_monitor(self):
        self.volume_monitor = (
            Gio.VolumeMonitor.get()
        )

        for signal_name in (
            "volume-added",
            "volume-changed",
            "volume-removed",
        ):
            self.volume_monitor.connect(
                signal_name,
                self.on_volume_event,
            )

        self.volume_monitor.connect(
            "drive-changed",
            self.on_drive_event,
        )

    def on_volume_event(
        self,
        _monitor,
        _volume,
    ):
        if not self.running:
            self.schedule_disc_detection()

    def on_drive_event(
        self,
        _monitor,
        _drive,
    ):
        if not self.running:
            self.schedule_disc_detection()

    def schedule_disc_detection(
        self,
        delay_ms=900,
    ):
        """
        GIO może zgłosić kilka zdarzeń podczas jednej zmiany
        stanu napędu. Debounce sprawia, że lsdvd zostanie
        uruchomione tylko raz po uspokojeniu zdarzeń.
        """

        if self.detect_timeout_id is not None:
            GLib.source_remove(
                self.detect_timeout_id
            )

        self.detect_timeout_id = (
            GLib.timeout_add(
                delay_ms,
                self._scheduled_detection,
            )
        )

    def _scheduled_detection(self):
        self.detect_timeout_id = None

        self.detect_disc()

        return False

    # =========================================================
    # Detekcja DVD
    # =========================================================

    def on_refresh_clicked(
        self,
        _button,
    ):
        if not self.running:
            self.detect_disc()

    def detect_disc(self):
        if (
            self.running
            or self.detecting_disc
        ):
            return False

        self.detecting_disc = True

        self.stage_label.set_text(
            "Sprawdzanie napędu…"
        )

        threading.Thread(
            target=self._detect_disc_worker,
            daemon=True,
        ).start()

        return False

    def _detect_disc_worker(self):
        try:
            title = (
                self.backend.detect_dvd()
            )

            if not title:
                GLib.idle_add(
                    self.no_disc_detected
                )

                return

            size = (
                self.backend.medium_size()
            )

            GLib.idle_add(
                self.disc_detected,
                title,
                size,
            )

        except Exception:
            GLib.idle_add(
                self.no_disc_detected
            )

    def disc_detected(
        self,
        title,
        size,
    ):
        self.detecting_disc = False
        self.disc_present = True

        new_disc = (
            title != self.disc_title
        )

        self.disc_title = title
        self.disc_size = size

        escaped = (
            GLib.markup_escape_text(
                title
            )
        )

        if size:
            self.disc_label.set_markup(
                f"<b>{escaped}</b>\n"
                f"DVD-Video • {DEVICE} • "
                f"medium {self.format_size(size)}"
            )

        else:
            self.disc_label.set_markup(
                f"<b>{escaped}</b>\n"
                f"DVD-Video • {DEVICE}"
            )

        if (
            new_disc
            or self.output_path is None
        ):
            filename = (
                self.safe_filename(title)
                + ".iso"
            )

            self.output_path = (
                HOME / filename
            )

            self.output_entry.set_text(
                str(self.output_path)
            )

        self.stage_label.set_text(
            "Płyta DVD-Video jest gotowa "
            "do skopiowania."
        )

        self.progress.set_fraction(0)
        self.progress.set_text("")

        self.data_label.set_text(
            "Dane: —"
        )

        self.time_label.set_text(
            "Czas: —"
        )

        self.choose_button.set_sensitive(
            True
        )

        self.start_button.set_sensitive(
            True
        )

        self.eject_button.set_sensitive(
            True
        )

        return False

    def no_disc_detected(self):
        self.detecting_disc = False

        self.disc_present = False
        self.disc_title = None
        self.disc_size = None
        self.output_path = None

        self.disc_label.set_text(
            "Brak płyty\n"
            "Włóż płytę DVD-Video do napędu."
